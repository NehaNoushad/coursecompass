{
  "buildCommand": "node scripts/generate-sitemap.mjs && npx expo export -p web && node scripts/inject-jsonld.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/colleges/:id", "destination": "/colleges/[id]" },
    { "source": "/courses/:id", "destination": "/courses/[id]" }
  ]
}
